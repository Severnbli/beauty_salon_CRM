<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="169.0" prefWidth="350.0" spacing="15" style="-fx-background-color: #f4f4f4; -fx-padding: 20; -fx-border-color: #d3d3d3; -fx-border-radius: 10; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="by.bsuir.client.controllers.ConfirmEmailController">

    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Введите код подтверждения, отправленный на почту" textAlignment="CENTER" wrapText="true">
      <font>
         <Font size="8.0" />
      </font></Label>

    <TextField fx:id="codeField" maxWidth="200.0" promptText="Секретный код" style="-fx-font-size: 12px; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;" />

    <HBox alignment="CENTER" spacing="15">
        <Button onAction="#onConfirm" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 5; -fx-padding: 5 15;" text="Подтвердить" />
        <Button onAction="#onCancel" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 5; -fx-padding: 5 15;" text="Отмена" />
    </HBox>

</VBox>
